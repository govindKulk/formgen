generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String         @id @default(cuid())
  clerkUserId String         @unique
  email       String         @unique
  name        String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  firstName   String?
  image       String?
  lastName    String?
  phone       String?
  Form        Form[]
  responses   FormResponse[]
}

model Form {
  id                        String         @id @default(cuid())
  description               String?        @default("")
  content                   Json           @default("{\"steps\": [{\"id\": \"\", \"stepTitle\": \"First Step\", \"components\": []}], \"formData\": {}, \"currentStepIndex\": 0}")
  published                 Boolean        @default(false)
  visits                    Int            @default(0)
  submissions               Int            @default(0)
  shareUrl                  String         @unique @default(cuid())
  userId                    String
  acceptsAnonymousResponses Boolean        @default(false)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  primaryColor              String         @default("#3b82f6")
  submissionMessage         String         @default("Form submitted successfully!")
  title                     String         @default("My Form")
  allowAnonymous            Boolean        @default(true)
  allowDuplicates           Boolean        @default(true)
  clerkUserId               String
  User                      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses                 FormResponse[]
  visitRecords              FormVisit[]    @relation("FormVisitRecords")
}

model FormResponse {
  id                 String   @id @default(cuid())
  responderId        String?
  responderName      String?
  responderEmail     String?
  responderIp        String?
  responderUserAgent String?
  responderLocation  String?
  content            Json     @default("{}")
  formId             String
  createdAt          DateTime @default(now())
  clerkUserId        String? // anonymous responses may not have a clerkUserId
  updatedAt          DateTime @updatedAt @default(now())
  form               Form     @relation(fields: [formId], references: [id], onDelete: Cascade)
  user               User?    @relation(fields: [responderId], references: [id])
}

model FormVisit {
  id           String   @id @default(cuid())
  formId       String
  visitorIp    String
  userAgent    String?
  visitedAt    DateTime @default(now())
  visitorEmail String?
  form         Form     @relation("FormVisitRecords", fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, visitorIp, visitorEmail, visitedAt])
}
